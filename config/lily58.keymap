#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/ext_power.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/outputs.h>

// 1. Активируем саму шину, если это необходимо
&pro_micro_i2c {
    status = "okay";
};

// 2. ОТДЕЛЬНО обращаемся к экрану по его системной ссылке для изменения параметров
&nice_oled {
    width = <64>;  
    height = <128>;
    
    // Ваши рабочие настройки против вертикального отзеркаливания:
    segment-offset = <0>;
    page-offset = <0>;
    display-offset = <64>; 
    multiplex-ratio = <127>; 
    
    segment-remap;
    /delete-property/ com-invdir;
    /delete-property/ com-sequential; // Убирает сжатие/растянутость
    
    prechargep = <0x22>;
};


/ {
    /* 1. Объявляем физические или виртуальные клавиши через стандартный gpio-keys */
    /* Это создает phandle-узлы, которые ZMK сможет "увидеть" */

    left_keys: left_keys {
        compatible = "gpio-keys";

        wakeup_key_left: wakeup_key_left {
            /* Укажите здесь пин СТРОКИ вашей клавиши на левой половине */

            gpios = <&pro_micro 9 (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)>;
        };
    };

    right_keys: right_keys {
        compatible = "gpio-keys";

        wakeup_key_right: wakeup_key_right {
            /* Укажите здесь пин СТРОКИ вашей клавиши на правой половине */

            gpios = <&pro_micro 9 (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)>;
        };
    };

    /* 2. Привязываем созданные клавиши к драйверу пробуждения */

    wakeup_left: wakeup_left {
        compatible = "zmk,gpio-key-wakeup-trigger";
        wakeup-source;

        /* ПЕРЕДАЕМ ССЫЛКУ на созданный выше узел (а не пины напрямую!) */

        trigger = <&wakeup_key_left>;

        /* Укажите здесь пин СТОЛБЦА левой клавиши */

        extra-gpios = <&pro_micro 10 GPIO_ACTIVE_HIGH>;
    };

    wakeup_right: wakeup_right {
        compatible = "zmk,gpio-key-wakeup-trigger";
        wakeup-source;

        /* ССЫЛКА на узел правой клавиши */

        trigger = <&wakeup_key_right>;

        /* Укажите здесь пин СТОЛБЦА правой клавиши */

        extra-gpios = <&pro_micro 10 GPIO_ACTIVE_HIGH>;
    };

    /* 3. Регистрируем оба исправленных триггера в системе питания */

    soft_off_wakers {
        compatible = "zmk,soft-off-wakeup-sources";
        wakeup-sources = <&wakeup_left>, <&wakeup_right>;
    };

    keymap {
        compatible = "zmk,keymap";

        main {
            // ------------------------------------------------------------------------------------------------------------
            // |  ESC  |  1  |  2  |  3   |  4   |  5   |                   |  6   |  7    |  8    |  9   |   0   |   `   |
            // |  TAB  |  Q  |  W  |  E   |  R   |  T   |                   |  Y   |  U    |  I    |  O   |   P   |   -   |
            // |  CTRL |  A  |  S  |  D   |  F   |  G   |                   |  H   |  J    |  K    |  L   |   ;   |   '   |
            // | SHIFT |  Z  |  X  |  C   |  V   |  B   |   "["  |  |  "]"  |  N   |  M    |  ,    |  .   |   /   | SHIFT |
            //                     | ALT  | GUI  | LOWER|  SPACE |  | ENTER | RAISE| BSPC  | GUI   |

            display-name = "MAIN";
            bindings = <
&kp TILDE  &kp N1  &kp N2  &kp N3            &kp N4        &kp N5                               &kp N6  &kp N7     &kp N8        &kp N9   &kp N0            &kp EQUAL
&kp ESC    &kp Q   &kp W   &kp E             &kp R         &kp T                                &kp Y   &kp U      &kp I         &kp O    &kp P             &kp LEFT_BRACKET
&kp TAB    &kp A   &kp S   &kp D             &kp F         &kp G                                &kp H   &kp J      &kp K         &kp L    &kp SEMI          &kp RIGHT_BRACKET
&kp LSHFT  &kp Z   &kp X   &kp C             &kp V         &kp B   &kp DELETE    &kp BACKSPACE  &kp N   &kp M      &kp COMMA     &kp DOT  &kp SINGLE_QUOTE  &kp SLASH
                           &kp LEFT_CONTROL  &kp LEFT_GUI  &mo 1   &kp SPACE     &kp RET        &mo 2   &kp MINUS  &kp LEFT_ALT
            >;
        };

        control {
            // ------------------------------------------------------------------------------------------------------------
            // | BTCLR | BT1 | BT2 |  BT3 |  BT4 |  BT5 |                   |      |       |       |      |       |       |
            // |  F1   |  F2 |  F3 |  F4  |  F5  |  F6  |                   |  F7  |  F8   |  F9   |  F10 |  F11  |  F12  |
            // |   `   |  !  |  @  |  #   |  $   |  %   |                   |  ^   |  &    |  *    |  (   |   )   |   ~   |
            // |       |     |     |      |      |      |        |  |       |      |  _    |  +    |  {   |   }   |  "|"  |
            //                     |      |      |      |        |  |       |      |       |       |

            display-name = "CONTROL";
            bindings = <
&kp F12    &kp F1             &kp F2        &kp F3        &kp F4        &kp F5                    &kp F6         &kp F7           &kp F8       &kp F9        &kp F10               &kp F11
&soft_off  &bt BT_CLR         &bt BT_SEL 0  &bt BT_SEL 1  &bt BT_SEL 2  &none                     &none          &none            &none        &none         &none                 &kp K_CALC
&trans     &ext_power EP_ON   &bt BT_SEL 3  &bt BT_SEL 4  &none         &none                     &kp KP_DIVIDE  &kp KP_ASTERISK  &kp KP_PLUS  &kp KP_MINUS  &kp LEFT_PARENTHESIS  &kp RIGHT_PARENTHESIS
&trans     &ext_power EP_OFF  &out OUT_BLE  &out OUT_USB  &out OUT_TOG  &none   &trans    &trans  &kp BACKSLASH  &kp COMMA        &kp DOT      &kp EQUAL     &kp LEFT_BRACE        &kp RIGHT_BRACE
                                            &trans        &trans        &trans  &trans    &trans  &trans         &trans           &trans
            >;
        };

        media {
            // ------------------------------------------------------------------------------------------------------------
            // |       |     |     |      |      |      |                   |      |       |       |      |       |       |
            // |   `   |  1  |  2  |  3   |  4   |  5   |                   |  6   |   7   |   8   |  9   |   0   |       |
            // |   F1  |  F2 |  F3 |  F4  |  F5  |  F6  |                   |      |   <-  |   v   |  ^   |  ->   |       |
            // |   F7  |  F8 |  F9 |  F10 |  F11 |  F12 |        |  |       |  +   |   -   |   =   |  [   |   ]   |   \   |
            //                     |      |      |      |        |  |       |      |       |       |

            display-name = "MEDIA";
            bindings = <
&trans  &trans  &trans        &trans            &trans           &trans                            &trans              &trans          &trans    &trans     &trans  &trans
&trans  &none   &none         &none             &none            &kp CAPSLOCK                      &kp K_CONTEXT_MENU  &kp HOME        &kp UP    &kp END    &none   &soft_off
&trans  &none   &kp C_PREV    &kp C_PLAY_PAUSE  &kp C_NEXT       &kp KP_NUMLOCK                    &kp PG_UP           &kp LEFT_ARROW  &kp DOWN  &kp RIGHT  &none   &studio_unlock
&trans  &none   &kp C_VOL_DN  &kp C_MUTE        &kp C_VOLUME_UP  &kp INSERT      &trans    &trans  &kp PG_DN           &none           &none     &none      &none   &none
                              &trans            &trans           &trans          &trans    &trans  &trans              &trans          &trans
            >;
        };
    };
};
